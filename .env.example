# Sao chép thành .env rồi điền giá trị (hoặc chạy: npm run setup:env). KHÔNG commit file .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=engquiz
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=engquiz
POSTGRES_PORT=5433
DATABASE_URL=postgresql://engquiz:doi-mat-khau-nay@localhost:5433/engquiz

# --- Auth.js ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự: npx auth secret
AUTH_SECRET=
# Địa chỉ trang khi chạy local. Link trong email đăng nhập trỏ về đây.
# Cho máy khác cùng mạng dùng: npm run setup:lan (đổi thành http://<IP LAN>:<cổng>)
AUTH_URL=http://localhost:3000

# Đăng nhập Google (tùy chọn — bỏ trống thì ẩn nút Google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gửi link đăng nhập qua email, dạng smtp://user:pass@smtp.example.com:587
# Ở môi trường dev có thể bỏ trống: link đăng nhập được in ra terminal chạy `npm run dev`.
EMAIL_SERVER=
EMAIL_FROM=EngQuiz <no-reply@example.com>

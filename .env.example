# Sao chép thành .env rồi điền giá trị (hoặc chạy: npm run setup:env). KHÔNG commit file .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=engquiz
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=engquiz
POSTGRES_PORT=5433
DATABASE_URL=postgresql://engquiz:doi-mat-khau-nay@localhost:5433/engquiz

# --- Auth.js ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự: npx auth secret
AUTH_SECRET=
# Địa chỉ trang khi chạy local. Link trong email đăng nhập trỏ về đây.
# Cho máy khác cùng mạng dùng: npm run setup:lan (đổi thành http://<IP LAN>:<cổng>)
AUTH_URL=http://localhost:3000

# Đăng nhập Google (tùy chọn — bỏ trống thì ẩn nút Google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gửi link đăng nhập qua email, dạng smtp://user:pass@smtp.example.com:587
# Ở môi trường dev có thể bỏ trống: link đăng nhập được in ra terminal chạy `npm run dev`.
EMAIL_SERVER=
EMAIL_FROM=EngQuiz <no-reply@example.com>

# --- Luyện nói: AI chấm & sửa lỗi (Claude) ---
# Tạo khóa tại https://console.anthropic.com (mục API keys). Bỏ trống = tắt AI, phần đọc theo câu mẫu vẫn dùng được.
ENGQUIZ_ANTHROPIC_API_KEY=

# --- Gói AI (thanh toán chuyển khoản VietQR, admin duyệt tay) ---
# Email của admin (tài khoản EngQuiz) được duyệt đơn ở /admin/orders và nhận email báo đơn mới; nhiều email cách nhau dấu phẩy.
ENGQUIZ_ADMIN_EMAILS=
# Tài khoản nhận tiền. BANK_CODE là mã ngân hàng theo VietQR (vd VCB, MB, TCB, ACB, VPB, TPB, BIDV, ICB) hoặc BIN 6 số.
BANK_CODE=
BANK_ACCOUNT_NO=
# Tên chủ tài khoản viết HOA không dấu, đúng như trên ngân hàng (vd NGUYEN VAN A)
BANK_ACCOUNT_NAME=
